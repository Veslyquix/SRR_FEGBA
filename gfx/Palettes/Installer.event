#define palEntry(unitID, class1, class2, class3, class4, class5, class1_pal, class2_pal, class3_pal, class4_pal, class5_pal) "palEntry(unitID, class1, class2, class3, class4, class5, 0, 0, 0, 0, 0, 0, class1_pal, class2_pal, class3_pal, class4_pal, class5_pal, 0, 0, 0, 0, 0, 0)"
#define palEntry(unitID, class1, class2, class3, class4, class5, class6, class1_pal, class2_pal, class3_pal, class4_pal, class5_pal, class6_pal) "palEntry(unitID, class1, class2, class3, class4, class5, class6, 0, 0, 0, 0, 0, class1_pal, class2_pal, class3_pal, class4_pal, class5_pal, class6_pal, 0, 0, 0, 0, 0)"
#define palEntry(unitID, class1, class2, class3, class4, class5, class6, class7, class1_pal, class2_pal, class3_pal, class4_pal, class5_pal, class6_pal, class7_pal) "palEntry(unitID, class1, class2, class3, class4, class5, class6, class7, 0, 0, 0, 0, class1_pal, class2_pal, class3_pal, class4_pal, class5_pal, class6_pal, class7_pal, 0, 0, 0, 0)"
